{
  "name": "stillpoint-browser-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:extension": "tsc -b && vite build --config vite.extension.config.ts && node scripts/build-extension.mjs",
    "package:extension": "npm run build:extension && node scripts/package-extension.mjs",
    "test:extension": "playwright test --config extension.playwright.config.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.32",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/chrome": "^0.3.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "typescript": "~5.9.3",
    "vite": "^6.4.0",
    "vitest": "^3.2.4"
  }
}
